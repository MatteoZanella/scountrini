{
  "name": "scountrini",
  "version": "1.1.0",
  "private": true,
  "description": "PWA statica per fotografare scontrini e archiviarli su OneDrive per anno associativo e branca.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
