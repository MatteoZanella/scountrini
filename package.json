    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "node tests/e2e/run-pipeline.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@jsquash/webp": "1.5.0",
    "@techstark/opencv-js": "4.10.0-release.1",
    "@tesseract.js-data/ita": "^1.0.0",
    "autocompleter": "10.1.0",
    "fuse.js": "7.5.0",
    "jscanify": "1.4.2",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.12",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
