# Copy to .env.local and fill in. Values are embedded in the static build.
# Application (client) ID of your Microsoft Entra app registration (SPA platform).
VITE_MS_CLIENT_ID=
# Optional: https://login.microsoftonline.com/common (default) | /consumers | /<tenant-id or domain>
# Use the folder owner's tenant (e.g. /contoso.onmicrosoft.com) when the folder is in a OneDrive for Business.
VITE_MS_AUTHORITY=
# Optional: OneDrive sharing link of the "scontrini" folder, pre-filled for everyone.
VITE_SHARE_URL=
